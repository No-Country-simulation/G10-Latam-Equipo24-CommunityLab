# ------------------------------------------------------------------------------
# BACKEND (cómo elige get_llm_client)
# ------------------------------------------------------------------------------
# Valores: gemini | openai | ollama | rule_based
COMMUNITYLAB_LLM_BACKEND=ollama

# ------------------------------------------------------------------------------
# GOOGLE GEMINI (solo si COMMUNITYLAB_LLM_BACKEND=gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# OPENAI (solo si COMMUNITYLAB_LLM_BACKEND=openai)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# OLLAMA
# ------------------------------------------------------------------------------
# Solo necesario si COMMUNITYLAB_LLM_BACKEND=ollama
# Dos modos:
#   - Local: Ollama instalado y ejecutándose (ollama serve). Llamar a llama3.1,
#     mistral, qwen2.5, gemma2, etc. (sin API key).
#   - Nube: setear OLLAMA_API_KEY para usar el endpoint OpenAI-compatible
#     https://ollama.com/v1 (OLLAMA_BASE_URL lo sobreescribe). El modelo debe
#     ser un id del catálogo cloud (https://ollama.com/api/tags), ej. gemma4:31b.
OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# ------------------------------------------------------------------------------
# OCI OBJECT STORAGE (almacenamiento de activos del pipeline)
# ------------------------------------------------------------------------------
# Si faltan las credenciales, el pipeline degrada a un snapshot local en
# storage/activos/ con status "pendiente" (nada falla).
OCI_USER_ID=
OCI_PRIVATE_KEY_PATH=
OCI_FINGERPRINT=
OCI_TENANCY_ID=
OCI_REGION=
OCI_NAMESPACE=axcyr94oehmi
OCI_BUCKET_NAME=communitylab-activos-marketing