# ==============================================================================
# COMMUNITYLAB — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y completa los valores.
# El archivo '.env' está excluido por .gitignore.
# NUNCA subas llaves API ni credenciales reales al repositorio.

# ------------------------------------------------------------------------------
# BACKEND LLM
# ------------------------------------------------------------------------------
# Opciones actuales:
#   - rule_based : Sin API Key. Recomendado para desarrollo, pruebas y CI.
#   - gemini     : Google Gemini.
#   - openai     : OpenAI.
#   - ollama     : Modelo local mediante Ollama.
COMMUNITYLAB_LLM_BACKEND=rule_based

# ------------------------------------------------------------------------------
# GOOGLE GEMINI
# ------------------------------------------------------------------------------
# Solo necesario si COMMUNITYLAB_LLM_BACKEND=gemini
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# OPENAI
# ------------------------------------------------------------------------------
# Solo necesario si COMMUNITYLAB_LLM_BACKEND=openai
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# OLLAMA
# ------------------------------------------------------------------------------
# Solo necesario si COMMUNITYLAB_LLM_BACKEND=ollama
# Ollama debe estar instalado y ejecutándose localmente.
OLLAMA_MODEL=llama3.1
