    "decision_D-C": "Decidida en codigo (feat/unified-analyzer, 29/9): las categorias del analisis son las del enum InteractionType.",
    "tipo_en_casos_de_analisis": "Se fija en 'otro' para aislar la clasificacion del LLM del campo tipo de entrada.",
    "tipo_comentario_general": "Decidido el 28/9: comentario_general se mapea a otro; la ingesta ya emite otro (PR #63).",
    "aliases": {
      "@<clave>": "Referencia a otra clave de la misma seccion (casos_analizador_mock). El test la sustituye por el valor de esa clave antes de usar el caso. Ej.: @respuesta_valida -> casos_analizador_mock.respuesta_valida; @respuesta_por_defecto -> casos_analizador_mock.respuesta_por_defecto.",
      "texto con @<clave>": "Si el alias aparece dentro de un string, se sustituye por el JSON serializado de esa clave (ANL-03: respuesta envuelta en un bloque de codigo).",
      "@relevancia_por_defecto": "Atajo de respuesta_por_defecto.relevance.",
      "{\"excepcion\": ...}": "El mock no devuelve texto: lanza esa excepcion (ANL-06, ANL-07).",
      "valores descriptivos": "Los campos 'lote' y los 'esperado' que son texto describen el caso en lenguaje natural; el test los implementa a mano."
    },
    "estados": {
      "ESPECIFICADO": "Definido por las fichas (#68, #69, HU-S2-007) o por una decision del equipo.",
      "PROPUESTO": "Criterio no definido en las fichas; el duenio del modulo debe confirmarlo.",
      "FUERA_DE_ALCANCE": "Ficha quitada del MVP en la reestructuracion del 28/9 (si hay tiempo). Se conserva el caso para retomarlo."
    }
  },
