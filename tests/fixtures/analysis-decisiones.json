    "umbral_relevancia": 0.6,
    "sentimientos": [
      "positivo",
      "negativo",
      "neutral"
    ],
    "categorias_analisis": [
      "testimonio",
      "pregunta_tecnica",
      "feedback",
      "logro",
      "discusion",
      "otro"
